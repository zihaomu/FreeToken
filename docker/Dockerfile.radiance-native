ARG FREETOKEN_ROCM_BASE
FROM ${FREETOKEN_ROCM_BASE}
COPY python/ /opt/freetoken/python/
ENV PYTHONPATH=/opt/freetoken/python
ENV PYTHONDONTWRITEBYTECODE=1
ENV HF_HUB_OFFLINE=1
RUN test -x /opt/freetoken/python/freetoken/native/runtime/bin/freetoken-native-worker
LABEL org.freetoken.backend="radiance-native" org.freetoken.gpu="gfx1201" org.freetoken.rocm="10.1"
